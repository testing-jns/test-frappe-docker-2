# Copy to .env, then adjust. .env is never committed.
#
#   cp .env.example .env

# Compose project name. Becomes the prefix for containers, networks and volumes
# -- this is what keeps two projects from ever sharing anything. Must be unique.
# Use lowercase without spaces; Docker normalises anything else.
PROJECT_NAME=bizops-tenant

# The site bootstrap creates. Any .localhost name resolves to 127.0.0.1 in every
# modern browser, so /etc/hosts stays untouched.
SITE_NAME=bizops-tenant.localhost

# Host ports. Increment for each additional project.
# Check what is free first:  ss -ltn | grep 800
WEB_PORT=8000
SOCKETIO_PORT=9000
FILE_WATCHER_PORT=6787
DB_PORT=3306

# This bench runs with developer_mode on, which means Server Scripts can execute
# arbitrary Python. Leave it on 127.0.0.1 unless you genuinely need access from
# another machine -- and if you do, put it behind a reverse proxy.
BIND_HOST=127.0.0.1

# Frappe v16 pins the first two; they are not a choice.
#   apps/frappe/pyproject.toml  requires-python = ">=3.14,<3.15"
#   apps/frappe/package.json    "engines": {"node": ">=24"}
# For v15: version-15 / 3.11 / 18.16.0
FRAPPE_BRANCH=version-16
PYTHON_VERSION=3.14
NODE_VERSION=24.13.0
BENCH_VERSION=5.31.0

# Development credentials. This bench is not reachable from outside the host.
DB_ROOT_PASSWORD=root
ADMIN_PASSWORD=admin

# Match your own uid/gid so files under ./workspace stay editable from your IDE.
#   id -u ; id -g
HOST_UID=1000
HOST_GID=1000

# Fine-grained PAT with read access to the organisation's repositories.
# Better still: put it in your shell profile (export GITHUB_TOKEN=...) so it does
# not have to be rewritten for every project. The shell wins over .env.
GITHUB_TOKEN=

# BOOTSTRAP=0 disables automatic bench creation -- the container stays up and you
# run bench init yourself. For when the automation is the thing that is broken.
BOOTSTRAP=1
